# Database Configuration
# Option 1: Local MySQL
# DB_URL=jdbc:mysql://localhost:3306/aeroponics
# DB_USERNAME=root
# DB_PASSWORD=your_password_here

# Option 2: Railway MySQL (for local development via TCP Proxy)
# DB_URL=jdbc:mysql://[RAILWAY_TCP_PROXY_DOMAIN]:[RAILWAY_TCP_PROXY_PORT]/railway
# DB_USERNAME=root
# DB_PASSWORD=your_railway_password

# Option 3: Railway MySQL (for Railway deployment)
DB_URL=jdbc:mysql://railway_host:3306/railway
DB_USERNAME=root
DB_PASSWORD=your_railway_password
DB_DRIVER=com.mysql.cj.jdbc.Driver

# JPA/Hibernate Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# JWT Configuration
JWT_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_HOURS=24
JWT_ISSUER=Aeroponics
JWT_PRIVATE_KEY=classpath:private_key.pem
JWT_PUBLIC_KEY=classpath:public_key.pem

# Server Configuration
SERVER_PORT=8080

# File Upload Configuration
MAX_FILE_SIZE=200MB
MAX_REQUEST_SIZE=200MB

# Image Storage Configuration
FILE_IMAGE_DIR=${user.home}/aeroponics/images/
FILE_IMAGE_URL=http://localhost:8080/resources/

# Logging Configuration
LOG_FILE_NAME=/var/log/aeroponics/Aeroponics.log
LOG_FILE_PATTERN=/var/log/aeroponics/rolling/security-test.%d{yyyy-MM-dd}.%i.gz.log
LOG_MAX_FILE_SIZE=30MB
LOG_TOTAL_SIZE_CAP=1GB

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
